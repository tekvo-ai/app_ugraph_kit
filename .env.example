# Local development only. Copy to `.env` and fill in as needed.
#
# ugraph itself does NOT read this file — it reads API keys from `~/.config/ugraph/`
# (see `ugraph auth set`) or from the environment. This example exists so contributors
# know which variables the optional `[api]` extra looks for.

# Optional: only needed for `ugraph extract --backend api`
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: override where ugraph stores its config and keys (default ~/.config/ugraph)
# UGRAPH_CONFIG_HOME=

# Optional: default knowledge base, so you can omit --kb
# UGRAPH_KB=
